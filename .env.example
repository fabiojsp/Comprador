# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# --- Base de datos (Fase 1) ---
# Railway Postgres: copia la "DATABASE_URL" del servicio Postgres.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/cesta

# --- Sesión de la app (Fase 1) ---
# Cadena aleatoria de 32+ bytes. Genera una con: openssl rand -base64 48
APP_SESSION_SECRET=

# --- Cifrado de sesiones de tienda (Fase 2) ---
# 32 bytes en base64. Genera con: openssl rand -base64 32
SESSION_ENC_KEY=

# --- Worker (Fase 1) ---
# URL pública de la web y token compartido para que los workers (nube o Mac) pidan trabajos.
APP_URL=http://localhost:3000
WORKER_TOKEN=
# "cloud" o "home": qué tiendas atiende este worker (según affinity en packages/core/src/stores.ts).
WORKER_AFFINITY=cloud

# --- Conectores ---
# Máximo de peticiones por minuto a una misma tienda.
STORE_MAX_REQ_PER_MIN=20
# Ruta a un Chromium ya instalado (opcional; por defecto usa el de Playwright).
CHROMIUM_PATH=

# --- Bóveda de credenciales (opcional, solo uso personal; desactivar antes de comercializar) ---
VAULT_ENABLED=false
