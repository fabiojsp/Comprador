# Copia este archivo como .env para desarrollo local. En producción, estas variables se configuran en Netlify (Project configuration → Environment variables).
# Nunca subas .env al repositorio.

# Contraseña sencilla para entrar en la app desde el iPhone.
APP_PASSWORD=

# Secreto para firmar la cookie de acceso. Genera uno con: openssl rand -base64 48
APP_SESSION_SECRET=

# Máximo de peticiones por minuto a una misma tienda.
STORE_MAX_REQ_PER_MIN=20

# Ruta a un Chromium ya instalado (opcional, solo desarrollo).
CHROMIUM_PATH=
